<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Label: launchd 고유 식별자 -->
  <key>Label</key>
  <string>com.swkim0128.daily-scrum</string>

  <!--
    평일(월~금) 오전 09:50 실행 — 10:00 스크럼 게시 10분 전.
    Weekday 를 단일 dict 로 줄 수 없으므로 dict 5개 배열로 평일만 지정한다.
    (Weekday: 1=월 … 5=금. 0/7=일)
  -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>1</integer>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>50</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>2</integer>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>50</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>3</integer>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>50</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>4</integer>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>50</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>5</integer>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>50</integer>
    </dict>
  </array>

  <!--
    ProgramArguments:
      /usr/bin/caffeinate -i -s: 실행 중 시스템 슬립 방지
      /bin/zsh -lc: 로그인 셸로 PATH 등 환경변수 로드 보장
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>-s</string>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>/Users/eunsol/Project/vibe-dotfiles/vibe-tools/scrum_worker.sh</string>
  </array>

  <!-- 로그 경로 (launchd가 직접 리다이렉트) -->
  <key>StandardOutPath</key>
  <string>/Users/eunsol/Library/Logs/daily-scrum/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/eunsol/Library/Logs/daily-scrum/launchd.err</string>

  <!-- 부팅 시 자동 실행 안 함 (명시적 bootstrap 필요) -->
  <key>RunAtLoad</key>
  <false/>

  <!-- 환경변수: zsh -lc 사용으로 대부분 자동 로드되나, 명시적으로 설정 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/eunsol</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- PARA 볼트가 기본 경로($HOME/Project/para)가 아니면 명시적으로 지정:
    <key>PARA_VAULT</key>
    <string>/Users/eunsol/Project/para</string>
    -->
    <!-- claude CLI 가 위 PATH 에 없다면 명시적으로 지정:
    <key>CLAUDE_BIN</key>
    <string>/opt/homebrew/bin/claude</string>
    -->
  </dict>
</dict>
</plist>
