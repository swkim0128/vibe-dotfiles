.omc
prompts.bak/
.claude/
/.worktrees/
# 타임스탬프 백업 아티팩트 (예: cmux.json.bak-YYYYMMDD-HHMMSS,
# .tmux.conf.bak.YYYYMMDD-HHMMSS) — 구분자가 - 와 . 둘 다 쓰이므로 양쪽 모두 차단
*.bak-*
*.bak.*
# cmux 머신로컬 오버레이 (회사 경로 비커밋)
/vibe-tools/cmux-projects.local.txt
/vibe-tools/cmux-ops.local.txt
/vibe-tools/cmux-no-workspace.local.txt
# cmux 설정 저장 중 사용하는 로컬 잠금 파일
/cmux/*.cmux-write.lock
# 설치기가 하네스 정본으로 연결하는 기기별 helper 심링크
/vibe-tools/ghostty-open.applescript
/vibe-tools/terminal-backends.json
/vibe-tools/terminal_runtime.py
/vibe-tools/test_terminal_runtime.py
/vibe-tools/verify-terminal-runtime.sh
